#!/usr/bin/env bash
set -euo pipefail

# 架构检查：确保 src/ 中没有违规依赖 tests/ 的情况
# 规则只拦截本地 tests 边界（./tests、../tests、/tests + Python import tests），避免 third-party 包名含 tests 误报。

local_tests_path_re="(\\./tests(/[^'\\\"]*)?|\\.\\./tests(/[^'\\\"]*)?|/tests(/[^'\\\"]*)?)"

violations=$(
  {
    # ESM/CommonJS：本地 tests 路径（./tests、../tests、/tests）
    grep -rn -E "(import|from)[^\"']*[\"']${local_tests_path_re}[\"']" src/ 2>/dev/null || true
    grep -rn -E "require[[:space:]]*\\([[:space:]]*['\"]${local_tests_path_re}['\"][[:space:]]*\\)" src/ 2>/dev/null || true
    # Python：from tests import ... / import tests...
    grep -rn -E '^[[:space:]]*from[[:space:]]+tests(\.[A-Za-z_][A-Za-z0-9_]*)?[[:space:]]+import[[:space:]]+' src/ 2>/dev/null || true
    grep -rn -E '^[[:space:]]*import[[:space:]]+([^#]*,[[:space:]]*)?tests(\.[A-Za-z_][A-Za-z0-9_]*)?([[:space:]]+as[[:space:]]+[A-Za-z_][A-Za-z0-9_]*)?([[:space:]]*(,|$))' src/ 2>/dev/null || true
  } | sed '/^$/d' | sort -u
)

if [ -n "$violations" ]; then
  echo "[arch-check] FAIL: src/ 中发现违规依赖 tests/："
  echo "$violations"
  exit 1
fi

echo "[arch-check] OK"
